    1:     def checkout(self, command: CheckoutCommand) -> dict:
    8:         if command.shipping_method not in {item.value for item in ShippingMethod}:
                   raise ValidationError("Unsupported shipping method")
    2:         self.cart.set_shipping_method(command.shipping_method)
    2:         snapshot = self.cart_service.get_cart()
    2:         if not snapshot["items"]:
    1:             raise ValidationError("Cart is empty")
    2:         for item in snapshot["items"]:
    1:             product = self.products.get(item["product"]["id"])
    1:             if not product:
                       raise NotFoundError("Product not found during checkout")
