                       raise InventoryError(f"Insufficient stock for {product.name}")
    2:         for item in snapshot["items"]:
    1:             product = self.products.get(item["product"]["id"])
    1:             product.stock -= item["quantity"]
    1:             self.products.update(product)
    2:         order = Order(
    1:             id=self.orders.next_id(),
    1:             user_id=self.current_user.id,
    1:             customer_name=command.customer_name,
    1:             email=command.email,
    1:             address=command.address,
    1:             shipping_method=ShippingMethod(command.shipping_method),
    1:             status=OrderStatus.confirmed,
    1:             items=snapshot["items"],
    1:             pricing=snapshot["pricing"],
    1:             coupon_code=snapshot["coupon_code"],
               )
    1:         self.orders.create(order)
