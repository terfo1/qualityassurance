    1: from typing import Protocol
       
    1: from app.domain.entities import CartItem, Coupon, Order, Product, Review, User
       
       
    2: class UserRepository(Protocol):
    1:     def get(self, user_id: int) -> User | None: ...
    1:     def get_by_email(self, email: str) -> User | None: ...
    1:     def create(self, user: User) -> User: ...
    1:     def next_id(self) -> int: ...
       
       
    2: class ProductRepository(Protocol):
    1:     def list(self) -> list[Product]: ...
    1:     def get(self, product_id: int) -> Product | None: ...
    1:     def create(self, product: Product) -> Product: ...
    1:     def update(self, product: Product) -> Product: ...
    1:     def delete(self, product_id: int) -> None: ...
    1:     def next_id(self) -> int: ...
       
       
    2: class CartRepository(Protocol):
    1:     def list_items(self) -> list[CartItem]: ...
    1:     def get_item(self, product_id: int) -> CartItem | None: ...
    1:     def set_item(self, item: CartItem) -> CartItem: ...
    1:     def delete_item(self, product_id: int) -> None: ...
    1:     def clear(self) -> None: ...
    1:     def set_coupon(self, code: str | None) -> None: ...
    1:     def get_coupon(self) -> str | None: ...
    1:     def set_shipping_method(self, shipping_method: str) -> None: ...
    1:     def get_shipping_method(self) -> str: ...
       
       
    2: class OrderRepository(Protocol):
    1:     def list(self) -> list[Order]: ...
    1:     def get(self, order_id: int) -> Order | None: ...
    1:     def create(self, order: Order) -> Order: ...
    1:     def update(self, order: Order) -> Order: ...
    1:     def next_id(self) -> int: ...
       
       
    2: class CouponRepository(Protocol):
    1:     def list(self) -> list[Coupon]: ...
    1:     def get(self, code: str) -> Coupon | None: ...
       
       
    2: class ReviewRepository(Protocol):
    1:     def list_for_product(self, product_id: int) -> list[Review]: ...
    1:     def create(self, review: Review) -> Review: ...
    1:     def next_id(self) -> int: ...
