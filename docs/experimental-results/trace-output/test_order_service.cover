    1:                 shipping_method="standard",
                   )
               )
       
    1:         self.assertEqual(order["status"], "confirmed")
    1:         self.assertEqual(len(self.orders.list()), 1)
    1:         self.assertEqual(self.cart_service.get_cart()["count"], 0)
    1:         self.assertEqual(self.products.get(1).stock, initial_stock - 2)
       
