    1: import base64
    1: import hashlib
    1: import hmac
    1: import secrets
    1: import time
       
    1: from app.config import settings
       
       
    1: def hash_password(password: str, salt: str | None = None) -> str:
   10:     salt_value = salt or secrets.token_hex(16)
    6:     digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt_value.encode("utf-8"), 120000)
    6:     return f"pbkdf2_sha256${salt_value}${base64.b64encode(digest).decode('utf-8')}"
       
       
    1: def verify_password(password: str, hashed_password: str) -> bool:
    2:     algorithm, salt, digest = hashed_password.split("$", 2)
    2:     if algorithm != "pbkdf2_sha256":
               return False
    2:     expected = hash_password(password, salt)
    2:     return hmac.compare_digest(expected, hashed_password)
       
       
    1: def create_token(user_id: int) -> str:
    2:     timestamp = str(int(time.time()))
    2:     nonce = secrets.token_hex(8)
    2:     payload = f"{user_id}:{timestamp}:{nonce}"
    2:     signature = hmac.new(settings.auth_secret.encode("utf-8"), payload.encode("utf-8"), hashlib.sha256).hexdigest()
    2:     encoded = base64.urlsafe_b64encode(f"{payload}:{signature}".encode("utf-8")).decode("utf-8")
    2:     return encoded
       
       
    1: def decode_token(token: str) -> int | None:
           try:
               raw = base64.urlsafe_b64decode(token.encode("utf-8")).decode("utf-8")
               user_id, timestamp, nonce, signature = raw.split(":", 3)
               payload = f"{user_id}:{timestamp}:{nonce}"
               expected = hmac.new(settings.auth_secret.encode("utf-8"), payload.encode("utf-8"), hashlib.sha256).hexdigest()
               if not hmac.compare_digest(expected, signature):
                   return None
               return int(user_id)
           except Exception:
               return None
