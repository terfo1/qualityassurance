    1:     def test_register_creates_lowercased_user_and_token(self) -> None:
    2:         payload = RegisterUserCommand(
    1:             email="Buyer@Example.com",
    1:             full_name="Buyer One",
    1:             password="Buyer123!",
               )
       
    1:         result = self.service.register(payload)
       
    1:         self.assertIn("token", result)
    1:         self.assertEqual(result["user"]["email"], "buyer@example.com")
    1:         self.assertIsNotNone(self.users.get_by_email("buyer@example.com"))
       
