    2:                 RegisterUserCommand(
    1:                     email="buyer@example.com",
    1:                     full_name="Buyer Two",
    1:                     password="Buyer456!",
                       )
                   )
       
    1:     def test_login_rejects_wrong_password(self) -> None:
    2:         self.users.seed_user(
    1:             email="buyer@example.com",
    1:             full_name="Buyer One",
    1:             password_hash=hash_password("Buyer123!"),
               )
       
    2:         with self.assertRaises(ValidationError):
    1:             self.service.login(LoginCommand(email="buyer@example.com", password="WrongPass1!"))
       
    1:     def test_login_rejects_inactive_user(self) -> None:
    2:         self.users.seed_user(
    1:             email="buyer@example.com",
