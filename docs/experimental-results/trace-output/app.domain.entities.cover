    3: @dataclass
    2: class Order:
    1:     id: int | None
    1:     user_id: int | None
    1:     customer_name: str
    1:     email: str
    1:     address: str
    1:     shipping_method: ShippingMethod
    1:     status: OrderStatus
    1:     items: list[dict]
    1:     pricing: dict
    1:     coupon_code: str | None = None
       
    1:     def to_dict(self) -> dict:
    1:         data = asdict(self)
