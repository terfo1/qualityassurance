    1:     pickup = "pickup"
       
       
    2: class OrderStatus(StrEnum):
    1:     pending = "pending"
    1:     confirmed = "confirmed"
    1:     fulfilled = "fulfilled"
       
       
    2: class UserRole(StrEnum):
    1:     admin = "admin"
    1:     customer = "customer"
       
       
    3: @dataclass
    2: class User:
    1:     id: int
    1:     email: str
    1:     full_name: str
    1:     password_hash: str
    1:     role: UserRole
    1:     is_active: bool = True
       
    1:     def to_dict(self) -> dict:
    2:         data = asdict(self)
    2:         data["role"] = self.role.value
    2:         data.pop("password_hash", None)
    2:         return data
       
       
